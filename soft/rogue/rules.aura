;; Two drop/AI rule packs on one seeded dungeon.
;; greedy: loot +1 HP / +2 ATK, aggressive AI (ai-div=1).
;; safe:   loot +4 HP / +0 ATK, timid AI (ai-div=2).
;; Longer survival is stamped into the main slot. The other is dropped.
;; fiber_live only when both fiber joins return a numeric score.
;; Otherwise the same thunks run host-sequential. Never a fake fiber_live.

(define *score-greedy* 0)
(define *score-safe* 0)
(define *keep-mid* 0)
(define *drop-mid* 0)
(define *keep-reason* "boot")
(define *drop-reason* "boot")
(define *main-name* "none")
(define *main-mid* 0)
(define *main-score* 0)
(define *world-line* "host-sequential")
(define *race-backend* 0)
(define *race-spawned* 0)
(define *race-joined* 0)

;; mid 1. greedy loot, aggressive enemy AI.
(define (rules-greedy)
  (rg:score 1 2 1))

;; mid 2. safe loot, timid enemy AI.
(define (rules-safe)
  (rg:score 4 0 2))

(define (rg:race-thunks! thunk-a thunk-b)
  (set! *race-spawned* (+ *race-spawned* 2))
  (let ((b (try (fiber:spawn-backend) (catch (e) 0))))
    (if (and (number? b) (> b 0))
        (set! *race-backend* b))
    (let* ((f1 (try (fiber:spawn thunk-a) (catch (e) #f)))
           (f2 (try (fiber:spawn thunk-b) (catch (e) #f)))
           (r1 (if (and (number? f1) (> f1 0))
                   (try (fiber:join f1) (catch (e) #f))
                   #f))
           (r2 (if (and (number? f2) (> f2 0))
                   (try (fiber:join f2) (catch (e) #f))
                   #f)))
      (if (and (number? f1) (number? f2)
               (> f1 0) (> f2 0)
               (not (= f1 f2))
               (number? r1) (number? r2))
          (begin
            (set! *race-joined* (+ *race-joined* 2))
            (list r1 r2))
          (list (thunk-a) (thunk-b))))))

(define (rg:finish-world!)
  (if (and (> *race-spawned* 0)
           (= *race-joined* *race-spawned*)
           (> *race-backend* 0))
      (set! *world-line* "fiber_live")
      (set! *world-line* "host-sequential"))
  *world-line*)

(define (rg:stamp-world!)
  (rg:finish-world!)
  (display "WORLD line=")
  (display *world-line*)
  (display " backend=")
  (display (number->string *race-backend*))
  (display " joins=")
  (display (number->string *race-joined*))
  (display "/")
  (display (number->string *race-spawned*))
  (newline)
  *world-line*)

;; Strictly longer survival wins. Equal survival breaks on clarity (HP).
;; A full tie keeps greedy (mid 1).
(define (rg:decide! greedy safe)
  (set! *score-greedy* greedy)
  (set! *score-safe* safe)
  (cond
    ((> safe greedy)
     (set! *keep-mid* 2)
     (set! *drop-mid* 1)
     (set! *main-mid* 2)
     (set! *main-name* "rules-safe")
     (if (> (rg:alive-of safe) (rg:alive-of greedy))
         (begin
           (set! *keep-reason* "longer-survival-stamp")
           (set! *drop-reason* "shorter-survival-rollback"))
         (begin
           (set! *keep-reason* "higher-clarity-stamp")
           (set! *drop-reason* "lower-clarity-rollback")))
     (set! *main-score* (rg:stamp! 4 0 2 "rules-safe")))
    ((> greedy safe)
     (set! *keep-mid* 1)
     (set! *drop-mid* 2)
     (set! *main-mid* 1)
     (set! *main-name* "rules-greedy")
     (if (> (rg:alive-of greedy) (rg:alive-of safe))
         (begin
           (set! *keep-reason* "longer-survival-stamp")
           (set! *drop-reason* "shorter-survival-rollback"))
         (begin
           (set! *keep-reason* "higher-clarity-stamp")
           (set! *drop-reason* "lower-clarity-rollback")))
     (set! *main-score* (rg:stamp! 1 2 1 "rules-greedy")))
    (#t
     (set! *keep-mid* 1)
     (set! *drop-mid* 2)
     (set! *main-mid* 1)
     (set! *main-name* "rules-greedy")
     (set! *keep-reason* "tie-keep-greedy-stamp")
     (set! *drop-reason* "tie-drop-safe-rollback")
     (set! *main-score* (rg:stamp! 1 2 1 "rules-greedy"))))
  *main-mid*)

(define (rg:race!)
  (set! *race-backend* 0)
  (set! *race-spawned* 0)
  (set! *race-joined* 0)
  (set! *world-line* "host-sequential")
  (let ((pair (rg:race-thunks!
               (lambda () (rules-greedy))
               (lambda () (rules-safe)))))
    (rg:decide! (car pair) (car (cdr pair))))
  (rg:finish-world!)
  *main-mid*)

(define (rg:audit!)
  (display "RACE greedy=")
  (display (rg:nstr *score-greedy*))
  (display " safe=")
  (display (rg:nstr *score-safe*))
  (display " alive-greedy=")
  (display (number->string (rg:alive-of *score-greedy*)))
  (display " alive-safe=")
  (display (number->string (rg:alive-of *score-safe*)))
  (newline)
  (rg:stamp-world!)
  (display "MAIN slot=")
  (display *main-name*)
  (display " mid=")
  (display (number->string *main-mid*))
  (display " score=")
  (display (rg:nstr *main-score*))
  (display " loot=")
  (display (number->string *loot-hp*))
  (display "/")
  (display (number->string *loot-atk*))
  (display " ai-div=")
  (display (number->string *ai-div*))
  (display " alive=")
  (display (number->string *alive*))
  (display " clarity=")
  (display (number->string *clarity*))
  (display " hp=")
  (display (number->string *hp*))
  (display " atk=")
  (display (number->string *atk*))
  (newline)
  (display "KEEP mid=")
  (display (number->string *keep-mid*))
  (display " reason=")
  (display *keep-reason*)
  (newline)
  (display "DROP mid=")
  (display (number->string *drop-mid*))
  (display " reason=")
  (display *drop-reason*)
  (newline)
  0)
